# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# deployment artifacts (contains secrets and database)
/deploy/
/deploy_pg/
*.zip

# database files
/db/*.db

# backups (CSVs, progress files, reports)
/backups/*.csv
/backups/*.json
/backups/*.sql
/backups/*.txt
/backups/*.log
/migration-failures.csv
/db/*.db-journal
