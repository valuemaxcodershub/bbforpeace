# Environment Variables

# App
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (PostgreSQL - use Supabase, Neon, or local)
DATABASE_URI=postgresql://user:password@host:5432/database

# Payload CMS
PAYLOAD_SECRET=YOUR_SECRET_KEY_HERE_MINIMUM_32_CHARACTERS_LONG

# Super Admin (created on first run)
SUPER_ADMIN_EMAIL=superadmin@bbforpeace.org
SUPER_ADMIN_PASSWORD=YOUR_STRONG_PASSWORD_12_CHARS_MIN

# Vercel Blob Storage (for file uploads on Vercel)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxx

# Email (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=info@bbforpeace.org
SMTP_PASS=your_password_here
